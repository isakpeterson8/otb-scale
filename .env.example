# Copy to .env and fill in. Never commit the filled-in file.

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Every admin/internal notification email is CC'd here. Defaults to
# support@outsidethebachs.com; set to an empty value to turn the CC off.
ADMIN_NOTIFICATION_CC=support@outsidethebachs.com
